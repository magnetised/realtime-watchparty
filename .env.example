# Created automatically by `pnpm provision` when NEON_API_KEY targets staging.
DATABASE_URL=postgresql://user:password@host/watchparty?sslmode=require
NEON_REALTIME_URL=wss://example/realtime/v1
NEON_REALTIME_SECRET=nrt_live_1_replace_me

# Optional. Without this, discovery uses a public Piped-compatible search API
# and always keeps a small built-in catalogue available.
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_API_URL=https://pipedapi.kavin.rocks

PORT=8787
